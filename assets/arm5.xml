<!--
  arm5: манипулятор с 5 вращательными степенями свободы и параллельным захватом.
  Кинематическая схема совпадает с SO-101 (yaw-pitch-pitch-pitch-roll + захват).

  Домашняя конфигурация (все углы = 0): рука вертикальна, захват направлен вверх (+z).
  Оси шарниров в домашней конфигурации (мировая система, метры):
    j1  shoulder_pan   ω = (0,0,1)  точка оси q = (0, 0, 0.06)
    j2  shoulder_lift  ω = (0,1,0)  q = (0, 0, 0.12)
    j3  elbow_flex     ω = (0,1,0)  q = (0, 0, 0.32)
    j4  wrist_flex     ω = (0,1,0)  q = (0, 0, 0.50)
    j5  wrist_roll     ω = (0,0,1)  q = (0, 0, 0.56)
    site ee (центр захвата) в домашней конфигурации: (0, 0, 0.635)
  Полный вывод: docs/lectures/L3_kinematics_screw_theory.md; проверка: tests/test_kinematics.py.

  Геометрия делится на три класса:
    по умолчанию — несущие звенья: масса (density=1000) и коллизии с полом;
    "visual"     — корпуса приводов, накладки: без массы и коллизий (density=0), группа 1;
    "axis"       — отметки осей шарниров (ω_i), группа 3: скрыты по умолчанию,
                   в окне MuJoCo включаются клавишей 3.
  Коллизии (contype/conaffinity): звенья сталкиваются только с полом, пальцы — с полом
  и объектом, объект — с полом и пальцами. Звенья друг с другом не сталкиваются.
-->
<mujoco model="arm5">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic"/>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom type="capsule" size="0.025" density="1000" material="shell"
          contype="2" conaffinity="0" friction="1 0.005 0.0001"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" density="0" group="1" material="motor"/>
    </default>
    <default class="axis">
      <geom type="cylinder" size="0.0035 0.07" contype="0" conaffinity="0" density="0" group="3"/>
    </default>
    <default class="finger">
      <joint type="slide" damping="2" armature="0.001" range="0 0.03"/>
      <geom type="box" size="0.008 0.004 0.03" material="motor"
            contype="1" conaffinity="1" condim="4" friction="1.5 0.01 0.0005"/>
    </default>
    <position forcerange="-50 50"/>
  </default>

  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="4096" offsamples="8"/>
    <headlight ambient="0.35 0.35 0.38" diffuse="0.45 0.45 0.45" specular="0.1 0.1 0.1"/>
    <map shadowclip="2"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.62 0.72 0.86" rgb2="0.14 0.15 0.2" width="32" height="512"/>
    <texture name="table" type="2d" builtin="checker" rgb1="0.76 0.76 0.78" rgb2="0.68 0.68 0.71"
             mark="edge" markrgb="0.6 0.6 0.63" width="300" height="300"/>
    <material name="table" texture="table" texrepeat="10 10" reflectance="0.03" specular="0.2" shininess="0.3"/>
    <material name="shell" rgba="0.93 0.93 0.95 1" specular="0.3" shininess="0.5"/>
    <material name="motor" rgba="0.13 0.13 0.15 1" specular="0.4" shininess="0.6"/>
    <material name="pad" rgba="0.22 0.22 0.22 1" specular="0.05" shininess="0.1"/>
    <material name="base" rgba="0.3 0.31 0.34 1" specular="0.3" shininess="0.4"/>
    <material name="cube" rgba="0.92 0.45 0.12 1" specular="0.2" shininess="0.3"/>
    <material name="target_mat" rgba="0.1 0.95 0.3 1" emission="1.0"/>
    <material name="axis_z" rgba="0.2 0.4 1 1" emission="0.5"/>
    <material name="axis_y" rgba="0.1 0.8 0.3 1" emission="0.5"/>
  </asset>

  <worldbody>
    <light pos="0.6 0.6 2.0" dir="-0.3 -0.3 -1" diffuse="0.75 0.75 0.75" specular="0.3 0.3 0.3" castshadow="true"/>
    <light pos="-1 0.5 1.5" dir="0.6 -0.3 -1" diffuse="0.3 0.3 0.33" castshadow="false"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="table" contype="1" conaffinity="3"/>
    <!-- смотрит из (0.75,-0.6,0.45) в точку (0.25,0,0.10) — зона захвата -->
    <camera name="front" pos="0.75 -0.6 0.45" xyaxes="0.768 0.640 0 -0.262 0.314 0.912" fovy="45"/>
    <camera name="top" pos="0.3 0 1.2" xyaxes="0 1 0 -1 0 0" fovy="45"/>
    <camera name="side" pos="0.3 -1.0 0.35" xyaxes="1 0 0 0 0.3 0.954" fovy="40"/>

    <!-- основание: плита и корпус привода j1 -->
    <geom type="cylinder" size="0.07 0.008" pos="0 0 0.008" material="base" contype="0" conaffinity="0"/>
    <geom type="cylinder" size="0.05 0.022" pos="0 0 0.038" material="motor" contype="0" conaffinity="0"/>

    <body name="shoulder_link" pos="0 0 0.06">
      <joint name="j1" axis="0 0 1" range="-3.1 3.1"/>
      <geom type="cylinder" size="0.035 0.03" pos="0 0 0.03" material="base" contype="0" conaffinity="0"/>
      <geom class="axis" material="axis_z" size="0.0035 0.1" pos="0 0 0.08"/>

      <body name="upper_arm" pos="0 0 0.06">
        <joint name="j2" axis="0 1 0" range="-1.7 1.7"/>
        <geom fromto="0 0 0 0 0 0.20"/>
        <!-- корпус привода j2: цилиндр вдоль оси шарнира (y) -->
        <geom class="visual" type="cylinder" size="0.032 0.03" quat="0.7071068 0.7071068 0 0"/>
        <geom class="axis" material="axis_y" quat="0.7071068 0.7071068 0 0"/>

        <body name="forearm" pos="0 0 0.20">
          <joint name="j3" axis="0 1 0" range="-2.6 2.6"/>
          <geom fromto="0 0 0 0 0 0.18" size="0.022"/>
          <geom class="visual" type="cylinder" size="0.028 0.028" quat="0.7071068 0.7071068 0 0"/>
          <geom class="axis" material="axis_y" quat="0.7071068 0.7071068 0 0"/>

          <body name="wrist" pos="0 0 0.18">
            <joint name="j4" axis="0 1 0" range="-1.9 1.9"/>
            <geom fromto="0 0 0 0 0 0.06" size="0.02"/>
            <geom class="visual" type="cylinder" size="0.024 0.026" quat="0.7071068 0.7071068 0 0"/>
            <geom class="axis" material="axis_y" quat="0.7071068 0.7071068 0 0"/>

            <body name="hand" pos="0 0 0.06">
              <joint name="j5" axis="0 0 1" range="-3.1 3.1"/>
              <!-- корпус привода j5 и ладонь -->
              <geom class="visual" type="cylinder" size="0.023 0.012" pos="0 0 -0.012"/>
              <geom type="box" size="0.04 0.015 0.015" pos="0 0 0.015" material="base"/>
              <geom class="axis" material="axis_z" pos="0 0 0.03"/>
              <site name="ee" pos="0 0 0.075" type="sphere" size="0.006" rgba="0.95 0.2 0.2 1"/>
              <site name="hand_frame" pos="0 0 0" type="sphere" size="0.004" rgba="0 0 0 0"/>

              <body name="finger_left" pos="0 0.03 0.03" childclass="finger">
                <joint name="finger_left" axis="0 -1 0"/>
                <geom pos="0 0 0.03"/>
                <geom class="visual" type="box" size="0.0095 0.0045 0.02" pos="0 0 0.038" material="pad"/>
              </body>
              <body name="finger_right" pos="0 -0.03 0.03" childclass="finger">
                <joint name="finger_right" axis="0 1 0"/>
                <geom pos="0 0 0.03"/>
                <geom class="visual" type="box" size="0.0095 0.0045 0.02" pos="0 0 0.038" material="pad"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- объект манипуляции: кубик 3 см -->
    <body name="cube" pos="0.3 0 0.015">
      <freejoint name="cube"/>
      <geom name="cube" type="box" size="0.015 0.015 0.015" density="1200" material="cube"
            contype="1" conaffinity="1" condim="4" friction="1.5 0.01 0.0005"/>
    </body>

    <!-- визуальная отметка высоты подъёма -->
    <body name="target" mocap="true" pos="0.3 0 0.15">
      <site name="target" type="sphere" size="0.012" material="target_mat"/>
    </body>
  </worldbody>

  <!-- пальцы движутся зеркально: finger_right = finger_left -->
  <equality>
    <joint joint1="finger_right" joint2="finger_left" polycoef="0 1 0 0 0"/>
  </equality>

  <actuator>
    <position name="a1" joint="j1" kp="100" kv="10" ctrlrange="-3.1 3.1"/>
    <position name="a2" joint="j2" kp="150" kv="15" ctrlrange="-1.7 1.7"/>
    <position name="a3" joint="j3" kp="100" kv="10" ctrlrange="-2.6 2.6"/>
    <position name="a4" joint="j4" kp="50"  kv="5"  ctrlrange="-1.9 1.9"/>
    <position name="a5" joint="j5" kp="20"  kv="2"  ctrlrange="-3.1 3.1"/>
    <position name="gripper" joint="finger_left" kp="300" kv="5" ctrlrange="0 0.03" forcerange="-20 20"/>
  </actuator>
</mujoco>
