<!--
  arm5: манипулятор с 5 вращательными степенями свободы и параллельным захватом.
  Кинематическая схема совпадает с SO-101 (yaw-pitch-pitch-pitch-roll + захват).

  Домашняя конфигурация (все углы = 0): рука вертикальна, захват направлен вверх (+z).
  Оси шарниров в домашней конфигурации (мировая система, метры):
    j1  shoulder_pan   ω = (0,0,1)  точка оси q = (0, 0, 0.06)
    j2  shoulder_lift  ω = (0,1,0)  q = (0, 0, 0.12)
    j3  elbow_flex     ω = (0,1,0)  q = (0, 0, 0.32)
    j4  wrist_flex     ω = (0,1,0)  q = (0, 0, 0.50)
    j5  wrist_roll     ω = (0,0,1)  q = (0, 0, 0.56)
    site ee (центр захвата) в домашней конфигурации: (0, 0, 0.635)
  Полный вывод: docs/06_arm_geometry.md; численная проверка: tests/test_kinematics.py.

  Коллизии (contype/conaffinity): звенья сталкиваются только с полом, пальцы — с полом
  и объектом, объект — с полом и пальцами. Звенья друг с другом не сталкиваются.
-->
<mujoco model="arm5">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic"/>

  <default>
    <joint damping="0.5" armature="0.01"/>
    <geom type="capsule" size="0.025" density="1000" rgba="0.55 0.6 0.85 1"
          contype="2" conaffinity="0" friction="1 0.005 0.0001"/>
    <default class="finger">
      <joint type="slide" damping="2" armature="0.001" range="0 0.03"/>
      <geom type="box" size="0.008 0.004 0.03" rgba="0.25 0.25 0.3 1"
            contype="1" conaffinity="1" condim="4" friction="1.5 0.01 0.0005"/>
    </default>
    <position forcerange="-50 50"/>
  </default>

  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.7 0.9" rgb2="0.1 0.1 0.15" width="32" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.22 0.22 0.22" rgb2="0.32 0.32 0.32" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.05"/>
    <material name="target_mat" rgba="0.1 0.95 0.3 1" emission="1.0"/>
  </asset>

  <worldbody>
    <light pos="0.5 0.5 2.5" dir="-0.2 -0.2 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid" contype="1" conaffinity="3"/>
    <!-- смотрит из (0.75,-0.6,0.45) в точку (0.25,0,0.10) — зона захвата -->
    <camera name="front" pos="0.75 -0.6 0.45" xyaxes="0.768 0.640 0 -0.262 0.314 0.912" fovy="45"/>
    <camera name="top" pos="0.3 0 1.2" xyaxes="0 1 0 -1 0 0" fovy="45"/>

    <!-- основание -->
    <geom type="cylinder" size="0.05 0.03" pos="0 0 0.03" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>

    <body name="shoulder_link" pos="0 0 0.06">
      <joint name="j1" axis="0 0 1" range="-3.1 3.1"/>
      <geom type="cylinder" size="0.035 0.03" pos="0 0 0.03" rgba="0.4 0.4 0.45 1" contype="0" conaffinity="0"/>

      <body name="upper_arm" pos="0 0 0.06">
        <joint name="j2" axis="0 1 0" range="-1.7 1.7"/>
        <geom fromto="0 0 0 0 0 0.20"/>

        <body name="forearm" pos="0 0 0.20">
          <joint name="j3" axis="0 1 0" range="-2.6 2.6"/>
          <geom fromto="0 0 0 0 0 0.18" size="0.022"/>

          <body name="wrist" pos="0 0 0.18">
            <joint name="j4" axis="0 1 0" range="-1.9 1.9"/>
            <geom fromto="0 0 0 0 0 0.06" size="0.02"/>

            <body name="hand" pos="0 0 0.06">
              <joint name="j5" axis="0 0 1" range="-3.1 3.1"/>
              <geom type="box" size="0.04 0.015 0.015" pos="0 0 0.015" rgba="0.3 0.3 0.35 1"/>
              <site name="ee" pos="0 0 0.075" type="sphere" size="0.006" rgba="0.95 0.2 0.2 1"/>
              <site name="hand_frame" pos="0 0 0" type="sphere" size="0.004" rgba="0 0 0 0"/>

              <body name="finger_left" pos="0 0.03 0.03" childclass="finger">
                <joint name="finger_left" axis="0 -1 0"/>
                <geom pos="0 0 0.03"/>
              </body>
              <body name="finger_right" pos="0 -0.03 0.03" childclass="finger">
                <joint name="finger_right" axis="0 1 0"/>
                <geom pos="0 0 0.03"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- объект манипуляции: кубик 3 см -->
    <body name="cube" pos="0.3 0 0.015">
      <freejoint name="cube"/>
      <geom name="cube" type="box" size="0.015 0.015 0.015" density="1200" rgba="0.9 0.45 0.15 1"
            contype="1" conaffinity="1" condim="4" friction="1.5 0.01 0.0005"/>
    </body>

    <!-- визуальная отметка высоты подъёма -->
    <body name="target" mocap="true" pos="0.3 0 0.15">
      <site name="target" type="sphere" size="0.012" material="target_mat"/>
    </body>
  </worldbody>

  <!-- пальцы движутся зеркально: finger_right = finger_left -->
  <equality>
    <joint joint1="finger_right" joint2="finger_left" polycoef="0 1 0 0 0"/>
  </equality>

  <actuator>
    <position name="a1" joint="j1" kp="100" kv="10" ctrlrange="-3.1 3.1"/>
    <position name="a2" joint="j2" kp="150" kv="15" ctrlrange="-1.7 1.7"/>
    <position name="a3" joint="j3" kp="100" kv="10" ctrlrange="-2.6 2.6"/>
    <position name="a4" joint="j4" kp="50"  kv="5"  ctrlrange="-1.9 1.9"/>
    <position name="a5" joint="j5" kp="20"  kv="2"  ctrlrange="-3.1 3.1"/>
    <position name="gripper" joint="finger_left" kp="300" kv="5" ctrlrange="0 0.03" forcerange="-20 20"/>
  </actuator>
</mujoco>
