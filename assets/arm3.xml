<!--
  arm3: минимальная 3-DoF рука для первых экспериментов.
  j1 — поворот основания вокруг Z (yaw), j2 — плечо, j3 — локоть (обе вокруг Y).
  Актуаторы position: ctrl = целевой угол, внутри PD-регулятор (как у сервоприводов SO-101).
  site "ee" — конец руки, body "target" — mocap-тело с целью (двигаем из кода).
-->
<mujoco model="arm3">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="1.0" armature="0.01"/>
    <geom type="capsule" size="0.03" rgba="0.55 0.6 0.85 1" density="800" contype="1" conaffinity="1"/>
    <position kp="60" kv="4" forcerange="-40 40"/>
  </default>

  <visual>
    <global offwidth="640" offheight="480"/>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.7 0.9" rgb2="0.1 0.1 0.15" width="32" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.22 0.22 0.22" rgb2="0.32 0.32 0.32" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="6 6" reflectance="0.05"/>
    <material name="target_mat" rgba="0.1 0.95 0.3 1" emission="1.0"/>
  </asset>

  <worldbody>
    <light pos="0.5 0.5 2.5" dir="-0.2 -0.2 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid" contype="1" conaffinity="1"/>
    <!-- смотрит из (1.4,-1.4,1.2) в точку (0,0,0.45) — центр рабочей зоны -->
    <camera name="front" pos="1.4 -1.4 1.2" xyaxes="0.707 0.707 0 -0.25 0.25 0.935" fovy="50"/>

    <body name="base" pos="0 0 0.05">
      <geom type="cylinder" size="0.09 0.05" rgba="0.3 0.3 0.3 1" contype="0" conaffinity="0"/>
      <body name="link1" pos="0 0 0.05">
        <joint name="j1" axis="0 0 1" range="-3.1 3.1"/>
        <geom fromto="0 0 0 0 0 0.25" contype="0" conaffinity="0"/>
        <body name="link2" pos="0 0 0.25">
          <joint name="j2" axis="0 1 0" range="-1.9 1.9"/>
          <geom fromto="0 0 0 0 0 0.30"/>
          <body name="link3" pos="0 0 0.30">
            <joint name="j3" axis="0 1 0" range="-2.4 2.4"/>
            <geom fromto="0 0 0 0 0 0.25"/>
            <site name="ee" pos="0 0 0.25" type="sphere" size="0.025" rgba="0.95 0.2 0.2 1"/>
          </body>
        </body>
      </body>
    </body>

    <body name="target" mocap="true" pos="0.3 0.2 0.5">
      <site name="target" type="sphere" size="0.04" material="target_mat"/>
    </body>
  </worldbody>

  <actuator>
    <position name="a1" joint="j1" ctrlrange="-3.1 3.1"/>
    <position name="a2" joint="j2" ctrlrange="-1.9 1.9"/>
    <position name="a3" joint="j3" ctrlrange="-2.4 2.4"/>
  </actuator>
</mujoco>
